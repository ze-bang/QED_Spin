# https://editorconfig.org
# Companion to .clang-format and .pre-commit-config.yaml.
# Keep these three files consistent.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cc,cxx,cpp,hh,hpp,hxx,cu,cuh,inl,ipp,tpp}]
indent_size = 4
max_line_length = 100

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{cmake,CMakeLists.txt}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 2

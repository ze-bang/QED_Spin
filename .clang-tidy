# clang-tidy >= 17 expected.
#
# A conservative set: catches likely bugs and leaves style to the code (braces, declaration
# grouping, emplace, range loops and boolean rewrites are not checked). Every warning is an error:
# silence a justified one with NOLINT(check) at the call site and say why, not with a global
# exclusion. CI runs it over src/ (the clang-tidy job of .github/workflows/ci.yml).
# bugprone-unchecked-optional-access is off: clang-tidy 17 aborts in it ("maximum number of
# iterations reached") on the long sector drivers (eigs, dynamics, thermal). Sources are parsed without
# OpenMP (-fno-openmp in CI): the analyzer of clang 17 and 18 aborts on OpenMP regions.

---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  modernize-deprecated-headers,
  modernize-make-shared,
  modernize-make-unique,
  modernize-redundant-void-arg,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  portability-*,
  readability-avoid-const-params-in-decls,
  readability-const-return-type,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-deleted-default,
  readability-duplicate-include,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-static-accessed-through-instance,
  readability-string-compare,
  readability-uniqueptr-delete-release,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-branch-clone,
  -bugprone-unchecked-optional-access,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -performance-no-int-to-ptr,
  -performance-avoid-endl

WarningsAsErrors: '*'

# Don't lint third-party headers we don't control.
HeaderFilterRegex: '^.*/(include|src|tests)/(?!.*third_party).*\.(h|hpp|hh|hxx|cuh|tpp|inl|ipp)$'

FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: 'CamelCase'
  - key: readability-identifier-naming.NamespaceCase
    value: 'lower_case'
  - key: bugprone-argument-comment.StrictMode
    value: 'true'
  - key: cppcoreguidelines-init-variables.MathHeader
    value: '<cmath>'
  - key: modernize-use-override.OverrideSpelling
    value: 'override'
  - key: modernize-use-override.FinalSpelling
    value: 'final'
  - key: performance-for-range-copy.WarnOnAllAutoCopies
    value: 'true'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: ''

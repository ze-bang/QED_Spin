# Toolchain for the Digital Research Alliance clusters (Fir, Rorqual, Narval):
# StdEnv/2023, AMD EPYC hosts, AOCL BLAS/LAPACK behind FlexiBLAS, CUDA + NCCL.
# Sourced by scripts/build.sh and by job scripts; safe to source repeatedly.
module --force purge
module load StdEnv/2023 gcc/12.3 openmpi/4.1.5 aocl-blas/5.1 aocl-lapack/5.1
# scalapack is loaded only because it brings FlexiBLAS into the environment on this
# stack (BLAS_PROFILE=FLEXIBLAS); no ScaLAPACK routine is linked any more.
module load scalapack/2.2.0
module load cmake eigen arpack-ng hdf5-mpi
# CUDA first so cudacore is fixed, then an NCCL whose prerequisites match it.
module load cuda nccl/2.26.2
module load python/3.11.5 scipy-stack/2024b      # python BEFORE scipy-stack
[ -n "${EBROOTNCCL:-}" ] && export NCCL_ROOT="${EBROOTNCCL}"

export QED_BLAS_PROFILE=FLEXIBLAS
export FLEXIBLAS=AOCL                            # runtime backend selection
# hdf5-mpi sets LIBRARY_PATH only; the extension needs libhdf5_cpp at load time.
export LD_LIBRARY_PATH="${EBROOTHDF5:+$EBROOTHDF5/lib:}${LD_LIBRARY_PATH:-}"
export PYTHONNOUSERSITE=1

# =============================================================================
# .gitignore for QED_Spin
# -----------------------------------------------------------------------------
# Conventions:
#   - Source-controlled inputs (tests/fixtures/) are re-included after broad excludes.
#   - Run output directories that ED produces under arbitrary names
#     (e.g. output/, structure_factor_results/) are excluded.
#   - Editor- and OS-specific noise is excluded broadly.
# =============================================================================

# ---------------------------------------------------------------------------
# Build directories (CMake out-of-source builds)
# ---------------------------------------------------------------------------
build/
build-*/
build_*/
build_old/
cmake-build-*/
out/
_build/

# CMake user-local config (presets that override the shared ones)
CMakeUserPresets.json

# Optional generated compile DB (some IDEs prefer it tracked; we don't)
compile_commands.json

# ---------------------------------------------------------------------------
# Compiled binaries / object files
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.a
*.la
*.so
*.so.*
*.dylib
*.dll
*.exe

# CUDA fatbins / PTX
*.fatbin
*.cubin
*.ptx

# ---------------------------------------------------------------------------
# Benchmark logs written at the repository root
# ---------------------------------------------------------------------------
bench_all_backends.log
bench_vs_quspin*.log

# ---------------------------------------------------------------------------
# Python build / wheel / cache artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
dist/
wheels/
pip-wheel-metadata/
.python-version
.tox/
.nox/
.cache/
.mypy_cache/
.pyre/
.pytype/
.pytest_cache/
.ruff_cache/

# scikit-build-core / pybind11 build trees
_skbuild/
.scikit-build*/

# ---------------------------------------------------------------------------
# C++ / clang-tidy / sanitizer / coverage outputs
# ---------------------------------------------------------------------------
*.gcov
*.gcno
*.gcda
*.profraw
*.profdata
coverage/
htmlcov/
.coverage
*.lcov
*.asan
*.ubsan
*.tsan
*.msan

# ---------------------------------------------------------------------------
# CTest / test artifacts
# ---------------------------------------------------------------------------
Testing/
LastTest.log
LastTestsFailed.log
CTestTestfile.cmake
DartConfiguration.tcl

# ---------------------------------------------------------------------------
# Run outputs, scratch directories, logs
# Inputs (tests/fixtures/) are re-included below.
# ---------------------------------------------------------------------------
*.h5
*.hdf5
*.log
*.out
*.err
*.slurm.out
*.checkpoint

# Scratch / output directories ED creates
output/
output_*/
results/
results_*/
structure_factor_results/
nlce_results/
nlce_runs/
tpq_results/
tpq_runs/
ed_results*/

# Bench output directories
bench_bl_*/
bench_full*/

# Allow tracked test fixtures back in
!tests/fixtures/**

# But automorphism_results/ subdirs are scratch outputs of the symmetry
# pre-computation step, not authored fixtures.
tests/fixtures/**/automorphism_results/

# ---------------------------------------------------------------------------
# Editor / IDE / OS metadata
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini

# Direnv / mise / asdf
.envrc
.direnv/
.tool-versions

# ---------------------------------------------------------------------------
# Doxygen / Sphinx output
# ---------------------------------------------------------------------------
docs/_build/
docs/html/
docs/xml/
docs/latex/
docs/doxygen/

# ---------------------------------------------------------------------------
# Local developer overrides (kept untracked by convention)
# ---------------------------------------------------------------------------
local.cmake
local.cmake.user
*.local.cmake

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Anchor 'core' / 'core.*' to root only so we don't accidentally exclude
# include/ed/core/ or any other src/ed/core/ directories.
/core
/core.*
*.dSYM/


# job logs and scratch golden recordings
/logs/
/tests/python/golden/refs/smoke/
bench/results/

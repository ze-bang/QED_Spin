# =============================================================================
# Doxyfile (templated by CMake -- see docs/CMakeLists.txt).
#
# Generates ONLY the XML output that Breathe / Sphinx will consume; we don't
# publish the raw Doxygen HTML. Run `cmake --build build --target doxygen` to
# regenerate, then `sphinx` (driven by docs/CMakeLists.txt) wraps the result
# into the public HTML site under build/docs/sphinx/.
# =============================================================================

PROJECT_NAME           = "@CMAKE_PROJECT_NAME@"
PROJECT_NUMBER         = "@CMAKE_PROJECT_VERSION@"
PROJECT_BRIEF          = "Exact diagonalization library + CLI + Python bindings for quantum spin systems."

OUTPUT_DIRECTORY       = @DOXYGEN_OUT@
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
CREATE_SUBDIRS         = NO

INPUT                  = @DOXYGEN_INPUT_DIRS@
RECURSIVE              = YES
EXTENSION_MAPPING      = cuh=C++ inl=C++ tpp=C++ ipp=C++
FILE_PATTERNS          = *.h *.hpp *.hh *.hxx *.cuh *.tpp *.inl *.ipp

# Don't waste time on third-party / vendored sources; we only document our
# own public API (include/ed/**) plus the Python bindings.
EXCLUDE_PATTERNS       = */build/* */.venv/* */third_party/* */_deps/*

# Include private comments + grouped pages so the Sphinx side can xref them.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Preserve file/line in XML so Sphinx :doxygenfunction:: directives resolve.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
SHOW_FILES             = YES
SHOW_INCLUDE_FILES     = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = NO
WARN_IF_INCOMPLETE_DOC = NO
WARNINGS               = NO
WARN_AS_ERROR          = NO

# Useful preprocessor settings so doxygen sees the same code as the compiler.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = WITH_CUDA=1 WITH_MPI=1

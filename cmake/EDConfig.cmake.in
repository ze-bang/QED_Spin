@PACKAGE_INIT@

# -----------------------------------------------------------------------------
# EDConfig.cmake -- exposes the installed `ED` C++ libraries to downstream
# CMake projects via `find_package(ED CONFIG)`.
#
# Provides the imported targets:
#
#   ED::ed_io           Pure I/O helpers
#   ED::ed_core         Core types/config
#   ED::ed_solvers_cpu  CPU eigensolvers + thermal methods
#   ED::ed_solvers_gpu  GPU/CUDA solvers (only if installed with WITH_CUDA=ON)
#
# Downstream usage:
#
#   find_package(ED CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE ED::ed_solvers_cpu)
#
# Re-finds the transitive dependencies that the imported targets reference
# (BLAS / LAPACK / HDF5 / OpenMP / optionally MPI / CUDAToolkit).
# -----------------------------------------------------------------------------

include(CMakeFindDependencyMacro)

set(ED_VERSION             "@PROJECT_VERSION@")
set(ED_WITH_CUDA           "@WITH_CUDA@")
set(ED_WITH_MPI            "@WITH_MPI@")
set(ED_WITH_SCALAPACK      "@WITH_SCALAPACK@")
set(ED_BLAS_PROFILE        "@BLAS_PROFILE@")

find_dependency(Threads)

# OpenMP is optional but extremely commonly enabled.
if(NOT TARGET OpenMP::OpenMP_CXX)
    find_dependency(OpenMP)
endif()

# HDF5 with C++ bindings.
if(NOT HDF5_FOUND)
    find_dependency(HDF5 COMPONENTS CXX)
endif()

# Eigen3 (header-only, used pervasively).
if(NOT TARGET Eigen3::Eigen)
    find_dependency(Eigen3 NO_MODULE)
endif()

# nlohmann_json (used by construct_ham loaders).
if(NOT TARGET nlohmann_json::nlohmann_json)
    find_dependency(nlohmann_json)
endif()

if(ED_WITH_MPI)
    find_dependency(MPI COMPONENTS CXX)
endif()

if(ED_WITH_CUDA)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/EDTargets.cmake")

check_required_components(ED)

{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ci-linux",
            "displayName": "CI: Linux / GCC / OpenBLAS / Release",
            "description": "Used by .github/workflows/ci.yml: CPU-only Release build with OpenBLAS and pinned GCC. Cluster builds use scripts/build.sh instead.",
            "binaryDir": "${sourceDir}/build/ci-linux",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BLAS_PROFILE": "OPENBLAS",
                "WITH_CUDA": "OFF",
                "WITH_MPI": "OFF",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ci-linux",
            "configurePreset": "ci-linux",
            "jobs": 0
        }
    ],
    "testPresets": [
        {
            "name": "ci-linux",
            "configurePreset": "ci-linux",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false,
                "jobs": 0
            }
        }
    ]
}
